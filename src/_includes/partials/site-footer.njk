<footer class="site-footer" id="contact">
  <div class="container site-footer__inner">
    <div>
      <h2 class="site-footer__title">Get in touch</h2>
      <p class="site-footer__text">Open to Human Factors and HSI roles in the Antelope Valley, San Diego or remote.</p>
    </div>
    <ul class="site-footer__links">
      <li><a class="site-footer__link" href="mailto:{{ site.email }}">{{ site.email }}</a></li>
      <li><a class="site-footer__link" href="{{ site.linkedin }}">LinkedIn profile</a></li>
      <li><a class="site-footer__link" href="{{ root }}{{ site.resume }}" target="_blank" rel="noopener">Resume (PDF, 65 KB)<span class="visually-hidden">, opens in a new tab</span></a></li>
    </ul>
  </div>
  <p class="container site-footer__legal">© {{ site.year }} {{ site.name }}</p>
</footer>
